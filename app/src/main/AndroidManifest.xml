<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Overlay permission for floating controls -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground service permission -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Vibration for haptic feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Post notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Shizuku Permission -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application
        android:name=".GGMauseProApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GGMausePro"
        tools:targetApi="34">

        <!-- Main Activity -->
        <activity
            android:name=".activity.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GGMausePro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Settings Activity -->
        <activity
            android:name=".activity.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".activity.MainActivity"
            android:theme="@style/Theme.GGMausePro" />

        <!-- Key Mapping Activity -->
        <activity
            android:name=".activity.KeyMappingActivity"
            android:exported="false"
            android:label="@string/key_mapping_title"
            android:parentActivityName=".activity.MainActivity"
            android:theme="@style/Theme.GGMausePro" />

        <!-- Profile Activity -->
        <activity
            android:name=".activity.ProfileActivity"
            android:exported="false"
            android:label="@string/profile_title"
            android:parentActivityName=".activity.MainActivity"
            android:theme="@style/Theme.GGMausePro" />

        <!-- Accessibility Service for intercepting keyboard/mouse input -->
        <service
            android:name=".service.InputMapperService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Overlay Service for floating controls -->
        <service
            android:name=".service.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Overlay game controller floating mapping window" />
        </service>

    </application>

</manifest>
