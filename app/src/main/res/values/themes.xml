<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme - Material 3 Dark Gaming Theme -->
    <style name="Theme.GGMausePro" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorOnPrimary">@color/purple_on_primary</item>
        <item name="colorPrimaryContainer">@color/purple_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/purple_on_primary_container</item>
        <item name="colorPrimaryInverse">@color/purple_primary_variant</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/blue_secondary</item>
        <item name="colorOnSecondary">@color/blue_on_secondary</item>
        <item name="colorSecondaryContainer">@color/blue_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/blue_on_secondary_container</item>

        <!-- Tertiary colors -->
        <item name="colorTertiary">@color/cyan_tertiary</item>
        <item name="colorOnTertiary">@color/cyan_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/cyan_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/cyan_on_tertiary_container</item>

        <!-- Error colors -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>

        <!-- Background and Surface -->
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="colorOnBackground">@color/dark_on_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_on_surface</item>
        <item name="colorSurfaceVariant">@color/dark_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/dark_on_surface_variant</item>
        <item name="colorSurfaceInverse">@color/dark_on_surface</item>
        <item name="colorOnSurfaceInverse">@color/dark_surface</item>
        <item name="colorSurfaceContainerHigh">@color/dark_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/dark_surface_container_highest</item>

        <!-- Outline -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <!-- Status bar and navigation bar -->
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:navigationBarColor">@color/dark_background</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Ripple -->
        <item name="colorControlHighlight">@color/ripple_color</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/dark_background</item>
    </style>

    <!-- Theme for Settings Activity with ActionBar -->
    <style name="Theme.GGMausePro.Settings" parent="Theme.GGMausePro">
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
    </style>

    <!-- Theme for dialogs -->
    <style name="Theme.GGMausePro.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorSecondary">@color/blue_secondary</item>
        <item name="colorSurface">@color/dark_surface_container_high</item>
        <item name="colorOnSurface">@color/dark_on_surface</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.GGMausePro.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/purple_primary</item>
        <item name="android:textColor">@color/purple_on_primary</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.GGMausePro.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/blue_secondary</item>
        <item name="android:textColor">@color/blue_secondary</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.GGMausePro.Button.Danger" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/error_container</item>
        <item name="android:textColor">@color/on_error_container</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Card Styles -->
    <style name="Widget.GGMausePro.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Text Styles -->
    <style name="TextAppearance.GGMausePro.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/dark_on_surface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.GGMausePro.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/dark_on_surface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.GGMausePro.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/dark_on_surface_variant</item>
    </style>

    <style name="TextAppearance.GGMausePro.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/dark_on_surface_variant</item>
    </style>

    <!-- Status indicator styles -->
    <style name="Widget.GGMausePro.StatusActive">
        <item name="android:textColor">@color/status_active</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.GGMausePro.StatusInactive">
        <item name="android:textColor">@color/status_inactive</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
