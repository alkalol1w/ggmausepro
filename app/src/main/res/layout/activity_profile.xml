<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface_dark"
            app:title="@string/profiles_title"
            app:titleTextColor="@color/neon_green"
            app:navigationIconTint="@color/text_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Pre-built profiles section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@color/surface_variant">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prebuilt_profiles_title"
                android:textColor="@color/neon_blue"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrebuiltPubg"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="@string/profile_pubg"
                    android:textColor="@color/neon_yellow"
                    android:textSize="10sp"
                    android:textAllCaps="false"
                    android:layout_marginEnd="4dp"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/neon_yellow_dim"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrebuiltCod"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="@string/profile_cod"
                    android:textColor="@color/neon_orange"
                    android:textSize="10sp"
                    android:textAllCaps="false"
                    android:layout_marginHorizontal="4dp"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/neon_orange_dim"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrebuiltFreefire"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="@string/profile_freefire"
                    android:textColor="@color/neon_red"
                    android:textSize="10sp"
                    android:textAllCaps="false"
                    android:layout_marginStart="4dp"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/neon_red_dim"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color" />

        <!-- Import/Export buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImportProfile"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/import_profile"
                android:textColor="@color/neon_blue"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:layout_marginEnd="4dp"
                app:backgroundTint="@color/surface_variant"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportProfile"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/export_profile"
                android:textColor="@color/neon_green"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:layout_marginStart="4dp"
                app:backgroundTint="@color/surface_variant"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color" />

        <!-- Empty State -->
        <TextView
            android:id="@+id/tvEmptyProfiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/no_profiles"
            android:textColor="@color/text_hint"
            android:textSize="16sp"
            android:visibility="gone"
            android:lineSpacingExtra="4dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerProfiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddProfile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:contentDescription="@string/create_profile"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/neon_green"
        app:tint="@color/text_on_accent"
        app:fabSize="normal" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
