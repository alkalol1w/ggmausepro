<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#161626"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tuş Eşleme Ekle / Düzenle"
        android:textColor="#00FFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Etiket (örn: Ateş Et, Zıpla)"
        android:textColorHint="#888888">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editKeyLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tuş Ata (Klavyeden bir tuşa basın):"
        android:textColor="#FFFFFF"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btnDetectKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tuşa Basın (Şu an: Yok)"
        android:layout_marginTop="6dp"
        android:backgroundTint="#2D2D44" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Eylem Tipi:"
        android:textColor="#FFFFFF"
        android:layout_marginTop="12dp" />

    <Spinner
        android:id="@+id/spinnerActionType"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#2D2D44"
        android:layout_marginTop="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="İptal"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="#AAAAAA" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kaydet"
            android:layout_marginStart="8dp"
            android:backgroundTint="#00E676" />

    </LinearLayout>
</LinearLayout>
