<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardProfile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardBackgroundColor="#1A1A2E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgActiveIndicator"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/indicator_active"
            android:contentDescription="Aktif Profil" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PUBG Mobile"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtMappingCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18 tuş atandı"
                android:textColor="#888888"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnSelectProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seç"
            android:backgroundTint="#7C4DFF"
            android:textSize="12sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
