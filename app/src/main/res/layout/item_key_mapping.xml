<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="8dp"
    app:cardBackgroundColor="#1A1A2E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtKeyBadge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_overlay_key"
            android:gravity="center"
            android:text="W"
            android:textColor="#00FFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtKeyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="İleri Git (W)"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtKeyDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tip: Basılı Tut | Konum: (450, 800)"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchKeyEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
